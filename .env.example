# Backend (outflow-api) adresi.
# Gerçek cihazda test için bilgisayarının LAN IP'sini kullan (localhost çalışmaz):
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Production'da deploy edilmiş HTTPS adresi:
#   EXPO_PUBLIC_API_URL=https://outflow-api.example.com

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Demo / app-review girişi (backend gerektirmez): login ekranına aşağıdaki bilgileri
# girince o oturum in-memory mock backend'e yönlenir (src/lib/mockBackend.ts).
#   e-posta: demo@outflow.app   şifre: demo1234
